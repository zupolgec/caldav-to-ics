{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendario",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "build": { "command": "npm run build:css" },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Every 5 minutes, queue a refresh for every feed that is due.
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "calendario", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "FEEDS" }],
  "queues": {
    "producers": [{ "binding": "REFRESH_QUEUE", "queue": "calendario-refresh" }],
    "consumers": [{ "queue": "calendario-refresh", "max_batch_size": 5, "max_batch_timeout": 5, "max_retries": 3 }]
  },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "EMAIL_FROM": "",
    "REFRESH_MINUTES": "10"
  }
}
